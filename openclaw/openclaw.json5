// Configuración de OpenClaw para Grupo Cardinal. Sin secretos: todos vienen del entorno.
// Un agente por rol; cada agente solo puede usar el servidor MCP de su rol.
{
  // Migraciones que `openclaw doctor` ya aplicó a esta versión (el archivo es de solo lectura).
  meta: {
    migrations: { webhookListeners: true, modelPolicyAllowlist: true, utilityModelSeparation: true },
    lastTouchedVersion: "2026.11.6",
  },

  plugins: {
    entries: {
      anthropic: { enabled: true },
      // Sin uso aquí; además evitan que intente crear enlaces junto al archivo de config.
      canvas: { enabled: false },
      browser: { enabled: false },
    },
  },

  gateway: {
    mode: "local",
    port: 18789,
    bind: "lan", // dentro del contenedor; compose publica el puerto solo en 127.0.0.1
    auth: {
      mode: "token",
      token: { source: "env", provider: "default", id: "OPENCLAW_GATEWAY_TOKEN" },
      // Contra fuerza bruta: 10 intentos por minuto y luego 5 minutos de bloqueo.
      rateLimit: { maxAttempts: 10, windowMs: 60000, lockoutMs: 300000 },
    },
    // El panel web solo se acepta desde la máquina local.
    controlUi: {
      allowedOrigins: [
        "http://127.0.0.1:${OPENCLAW_PORT}",
        "http://localhost:${OPENCLAW_PORT}",
      ],
    },
  },

  // Sin tareas automáticas: el agente solo actúa cuando alguien le escribe.
  cron: { enabled: false },

  // Sin aprendizaje autónomo (por defecto "auto") ni navegador: comportamiento predecible.
  skills: {
    workshop: { autonomous: { mode: "off" } },
    entries: {
      "openai-whisper-api": { enabled: false },
      "sherpa-onnx-tts": { enabled: false },
    },
  },
  browser: { enabled: false, extensionRelay: { allowLegacyAuth: false } },

  // Mismo servidor MCP, un token distinto por rol: el servidor deduce el rol del token.
  mcp: {
    servers: {
      "cardinal-ventas": {
        url: "http://mcp-server:8000/mcp",
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${ROLE_TOKEN_VENTAS}" },
      },
      "cardinal-rh": {
        url: "http://mcp-server:8000/mcp",
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${ROLE_TOKEN_RH}" },
      },
      "cardinal-empleado": {
        url: "http://mcp-server:8000/mcp",
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${ROLE_TOKEN_EMPLEADO}" },
      },
      "cardinal-gerente": {
        url: "http://mcp-server:8000/mcp",
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${ROLE_TOKEN_GERENTE}" },
      },
    },
  },

  // Nada de herramientas propias de OpenClaw (shell, archivos, web, navegador...).
  tools: {
    deny: [
      "group:runtime",
      "group:fs",
      "group:web",
      "group:ui",
      "group:automation",
      "group:nodes",
      "group:messaging",
    ],
    swarm: false,
    elevated: { enabled: false },
    // Ningún agente puede leer ni escribir en conversaciones de otro (lo detectó el audit).
    sessions: { visibility: "self" },
    agentToAgent: { enabled: false },
  },

  agents: {
    ownership: "explicit",
    defaults: {
      model: "${OPENCLAW_MODEL}",
      // Tareas internas de OpenClaw: un agente aparte, sin herramientas ni bot.
      systemAgent: { agentId: "sistema" },
    },
    entries: {
      sistema: {
        name: "Sistema",
        workspace: "/home/node/.openclaw/workspace-sistema",
        tools: { allow: [] },
      },
      ventas: {
        name: "Ventas",
        workspace: "/home/node/.openclaw/workspace-ventas",
        tools: { allow: ["cardinal-ventas__*"] },
      },
      rh: {
        name: "Recursos Humanos",
        workspace: "/home/node/.openclaw/workspace-rh",
        tools: { allow: ["cardinal-rh__*"] },
      },
      empleado: {
        name: "Colaborador",
        workspace: "/home/node/.openclaw/workspace-empleado",
        tools: { allow: ["cardinal-empleado__*"] },
      },
      gerente: {
        name: "Gerencia",
        workspace: "/home/node/.openclaw/workspace-gerente",
        tools: { allow: ["cardinal-gerente__*"] },
      },
    },
  },

  // Un bot de Telegram por rol. dmPolicy "pairing": nadie habla con un bot sin aprobación.
  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "pairing",
      configWrites: false,
      defaultAccount: "ventas",
      accounts: {
        ventas: {
          botToken: { source: "env", provider: "default", id: "TELEGRAM_BOT_TOKEN_VENTAS" },
        },
        rh: {
          botToken: { source: "env", provider: "default", id: "TELEGRAM_BOT_TOKEN_RH" },
        },
        empleado: {
          botToken: { source: "env", provider: "default", id: "TELEGRAM_BOT_TOKEN_EMPLEADO" },
        },
        gerente: {
          botToken: { source: "env", provider: "default", id: "TELEGRAM_BOT_TOKEN_GERENTE" },
        },
      },
    },
  },

  bindings: [
    { agentId: "ventas", match: { channel: "telegram", accountId: "ventas" } },
    { agentId: "rh", match: { channel: "telegram", accountId: "rh" } },
    { agentId: "empleado", match: { channel: "telegram", accountId: "empleado" } },
    { agentId: "gerente", match: { channel: "telegram", accountId: "gerente" } },
  ],
}
