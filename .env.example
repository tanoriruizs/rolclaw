# Copia a .env, llena tus llaves y ejecuta `make tokens`. Nunca subas .env.

# Modelo
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENCLAW_MODEL=anthropic/claude-sonnet-5-5

# Bots de Telegram (uno por rol, creados con @BotFather)
TELEGRAM_BOT_TOKEN_VENTAS=
TELEGRAM_BOT_TOKEN_RH=
TELEGRAM_BOT_TOKEN_EMPLEADO=
TELEGRAM_BOT_TOKEN_GERENTE=

# Tokens de rol para el MCP server (los genera make tokens)
ROLE_TOKEN_VENTAS=
ROLE_TOKEN_RH=
ROLE_TOKEN_EMPLEADO=
ROLE_TOKEN_GERENTE=

# ServiceNow (mock local; el secreto lo genera make tokens)
SERVICENOW_BASE_URL=http://servicenow-mock:8100
SERVICENOW_CLIENT_ID=cardinal-assistant
SERVICENOW_CLIENT_SECRET=
