# Copia a .env, llena tus llaves y ejecuta `make tokens`. Nunca subas .env.

# Modelo (pega tu API key de Anthropic; para otro proveedor cambia OPENCLAW_MODEL)
ANTHROPIC_API_KEY=
OPENCLAW_MODEL=anthropic/claude-sonnet-5-5

# Bots de Telegram (uno por rol, creados con @BotFather)
TELEGRAM_BOT_TOKEN_VENTAS=
TELEGRAM_BOT_TOKEN_RH=
TELEGRAM_BOT_TOKEN_EMPLEADO=
TELEGRAM_BOT_TOKEN_GERENTE=
# Tu id de Telegram (aparece en el mensaje de pairing): make pairing solo aprueba este id
TELEGRAM_OWNER_ID=
# Avisos: el aprobador recibe un mensaje cuando llega una solicitud, y quien la pidió,
# cuando se decide. Pon false para que el MCP server no use los bots.
NOTIFICATIONS_ENABLED=true

# Tokens de rol para el MCP server (los genera make tokens)
ROLE_TOKEN_VENTAS=
ROLE_TOKEN_RH=
ROLE_TOKEN_EMPLEADO=
ROLE_TOKEN_GERENTE=

# MCP server (en Docker, compose sobrescribe REDIS_URL)
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0
# Puerto local donde docker compose publica el MCP server
MCP_PORT=8000

# ServiceNow (mock local; el secreto lo genera make tokens)
SERVICENOW_BASE_URL=http://servicenow-mock:8100
SERVICENOW_CLIENT_ID=cardinal-assistant
SERVICENOW_CLIENT_SECRET=

# OpenClaw (gateway en http://127.0.0.1:18790; el token lo genera make tokens)
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_PORT=18790
